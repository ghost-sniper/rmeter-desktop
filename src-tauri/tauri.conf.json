{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rmeter-desktop",
  "version": "0.1.1",
  "identifier": "com.administer.rmeter-desktop",
  "build": {
    "beforeDevCommand": "bun run desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rmeter · 测试计划",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/rmeter-js-worker"],
    "linux": {
      "deb": {
        "depends": ["libssl3 | libssl3t64"]
      },
      "rpm": {
        "depends": ["libssl.so.3()(64bit)", "libcrypto.so.3()(64bit)"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
