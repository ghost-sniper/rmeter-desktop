{
  "version": 1,
  "name": "Mock Studio 与 ipds_dev 八组件联动测试",
  "variables": {
    "visitor": "rmeter"
  },
  "defaults": {
    "request_timeout_ms": 5000,
    "use_system_proxy": false,
    "save_response_body": true
  },
  "groups": [
    {
      "name": "双用户联动",
      "users": 2,
      "ramp_up_ms": 100,
      "iterations": 1,
      "max_duration_ms": 30000,
      "on_error": "stop_user",
      "children": [
        {
          "type": "jdbc_connection_configuration",
          "name": "ipds_dev 只读查询",
          "variable_name": "db",
          "url": "postgresql://106.54.164.19:25432/ipds_dev?sslmode=disable",
          "username": "postgres",
          "password_env": "RMETER_INTEGRATION_DB_PASSWORD",
          "max_connections": 2,
          "connect_timeout_ms": 5000,
          "acquire_timeout_ms": 5000
        },
        {
          "type": "jdbc_request",
          "name": "JDBC initialize",
          "connection": "db",
          "query_type": "select",
          "sql": "SELECT current_database()::text AS database, current_user::text AS username, $1::integer AS item_id",
          "parameters": [42],
          "query_timeout_ms": 5000,
          "max_rows": 1,
          "max_result_bytes": 4096,
          "save_response_body": true,
          "result_variable": "db_result",
          "row_count_variable": "db_rows",
          "assertions": [
            {
              "type": "json",
              "name": "数据库身份",
              "path": "$.rows[0][0]",
              "matcher": {
                "type": "equals",
                "expected": "ipds_dev"
              }
            },
            {
              "type": "json",
              "name": "绑定参数",
              "path": "$.rows[0][2]",
              "matcher": {
                "type": "equals",
                "expected": 42
              }
            }
          ]
        },
        {
          "type": "javascript",
          "name": "JavaScript initialize",
          "script": "const result = JSON.parse(vars.get('db_result')); if (vars.get('db_result_#') !== '1' || result[0].database !== 'ipds_dev' || result[0].username !== 'postgres' || result[0].item_id !== 42) throw new Error('Unexpected JDBC identity or bound parameter'); vars.put('item_id', String(result[0].item_id)); vars.put('step', '0'); vars.put('again', 'true');",
          "timeout_ms": 1000,
          "max_variable_bytes": 65536
        },
        {
          "type": "if",
          "name": "数据库校验通过后执行 Mock",
          "condition": "${again}",
          "evaluate_all": true,
          "children": [
            {
              "type": "loop",
              "count": 2,
              "children": [
                {
                  "type": "http_request",
                  "name": "HTTP hello",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/hello/test",
                  "body": {
                    "type": "json",
                    "value": {
                      "name": "${visitor}",
                      "age": 20,
                      "email": "rmeter@example.test"
                    }
                  },
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.code",
                      "matcher": {
                        "type": "equals",
                        "expected": 200
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "21岁"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP order success",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/order",
                  "body": {
                    "type": "json",
                    "value": {
                      "product_name": "rmeter mock test",
                      "product_id": 42,
                      "order_id": "rmeter-integration",
                      "count": 1,
                      "buyer_account": "rmeter-test",
                      "pay_method": "Alipay"
                    }
                  },
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.code",
                      "matcher": {
                        "type": "equals",
                        "expected": 200
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "下单成功"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP order UnionPay",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/order",
                  "body": {
                    "type": "json",
                    "value": {
                      "product_name": "rmeter mock test",
                      "product_id": 42,
                      "order_id": "rmeter-integration",
                      "count": 1,
                      "buyer_account": "rmeter-test",
                      "pay_method": "UnionPay"
                    }
                  },
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.code",
                      "matcher": {
                        "type": "equals",
                        "expected": 400
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "不支持银联支付方式"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP XML path",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/query/${item_id}",
                  "body": {
                    "type": "text",
                    "value": "<information>\n<id>12</id>\n</information>"
                  },
                  "settings": {
                    "headers": [["Content-Type", "application/xml"]]
                  },
                  "assertions": [
                    {
                      "type": "xml",
                      "name": "XPath 响应内容",
                      "xpath": "/information/id/text()",
                      "matcher": {
                        "type": "equals",
                        "expected": "12"
                      }
                    },
                    {
                      "type": "regex",
                      "name": "XML 正文匹配",
                      "pattern": "<message>232432</message>"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP JSONPath",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/examples/jsonpath",
                  "body": {
                    "type": "json",
                    "value": {
                      "orders": [
                        {
                          "qty": 2,
                          "status": "paid"
                        }
                      ]
                    }
                  },
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.matched",
                      "matcher": {
                        "type": "equals",
                        "expected": "jsonpath"
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "jsonpath"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP XPath",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/examples/xpath",
                  "body": {
                    "type": "text",
                    "value": "<o:order xmlns:o=\"urn:orders\"><o:status>paid</o:status></o:order>"
                  },
                  "settings": {
                    "headers": [["Content-Type", "application/xml"]]
                  },
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.matched",
                      "matcher": {
                        "type": "equals",
                        "expected": "xpath"
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "xpath"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP query",
                  "method": "GET",
                  "url": "http://127.0.0.1:9080/examples/query",
                  "settings": {
                    "query": [
                      ["status", "paid"],
                      ["source", "web"]
                    ]
                  },
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.matched",
                      "matcher": {
                        "type": "equals",
                        "expected": "query"
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "query"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP path",
                  "method": "GET",
                  "url": "http://127.0.0.1:9080/examples/items/${item_id}",
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.id",
                      "matcher": {
                        "type": "equals",
                        "expected": 42
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "path"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP regex",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/examples/regex",
                  "body": {
                    "type": "json",
                    "value": {
                      "code": "AB-42"
                    }
                  },
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.matched",
                      "matcher": {
                        "type": "equals",
                        "expected": "regex"
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "regex"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP JSON template",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/examples/template/json",
                  "body": {
                    "type": "json",
                    "value": {
                      "name": "${visitor}"
                    }
                  },
                  "assertions": [
                    {
                      "type": "json",
                      "name": "JSONPath 业务响应",
                      "path": "$.message",
                      "matcher": {
                        "type": "equals",
                        "expected": "Hello, rmeter!"
                      }
                    },
                    {
                      "type": "regex",
                      "name": "正文包含预期内容",
                      "pattern": "Hello, rmeter!"
                    }
                  ]
                },
                {
                  "type": "http_request",
                  "name": "HTTP XML template",
                  "method": "POST",
                  "url": "http://127.0.0.1:9080/examples/template/xml",
                  "body": {
                    "type": "text",
                    "value": "<request><name>${visitor}</name></request>"
                  },
                  "settings": {
                    "headers": [["Content-Type", "application/xml"]]
                  },
                  "assertions": [
                    {
                      "type": "xml",
                      "name": "XPath 响应内容",
                      "xpath": "/greeting/text()",
                      "matcher": {
                        "type": "equals",
                        "expected": "Hello, rmeter!"
                      }
                    },
                    {
                      "type": "regex",
                      "name": "XML 正文匹配",
                      "pattern": "^<greeting>Hello, rmeter!</greeting>$"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "while",
          "name": "变量控制两次参数查询",
          "condition": "${again}",
          "children": [
            {
              "type": "jdbc_request",
              "name": "JDBC while parameter",
              "connection": "db",
              "query_type": "select",
              "sql": "SELECT $1::integer AS step, $2::text AS marker",
              "parameters": ["${step}", "${visitor}"],
              "query_timeout_ms": 5000,
              "max_rows": 1,
              "max_result_bytes": 4096,
              "save_response_body": true,
              "result_variable": "step_result",
              "variable_names": ["db_step", "db_marker"],
              "row_count_variable": "db_rows",
              "assertions": [
                {
                  "type": "json",
                  "name": "返回一行",
                  "path": "$.row_count",
                  "matcher": {
                    "type": "equals",
                    "expected": 1
                  }
                }
              ]
            },
            {
              "type": "javascript",
              "name": "JavaScript advance",
              "script": "const result = JSON.parse(vars.get('step_result')); const step = Number(vars.get('step')); if (vars.get('step_result_#') !== '1' || result[0].step !== step || result[0].marker !== 'rmeter' || vars.get('db_step_1') !== String(step) || vars.get('db_marker_1') !== 'rmeter' || vars.get('db_step_#') !== '1') throw new Error('JDBC parameter or variable mismatch'); vars.put('step', String(step + 1)); vars.put('again', step + 1 < 2 ? 'true' : 'false');",
              "timeout_ms": 1000,
              "max_variable_bytes": 65536
            }
          ]
        },
        {
          "type": "if",
          "name": "While 退出后跳过",
          "condition": "${again}",
          "children": [
            {
              "type": "javascript",
              "name": "MUST NOT RUN",
              "script": "throw new Error('False IF was executed');",
              "timeout_ms": 1000,
              "max_variable_bytes": 65536
            }
          ]
        }
      ]
    }
  ]
}
